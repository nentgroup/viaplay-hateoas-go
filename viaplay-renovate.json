{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":semanticCommitTypeAll(deps)",
    "github>nentgroup/renovate-config:toce-bestpractices"
  ],
  "timezone": "Europe/Stockholm",
  "schedule": [
    "* 9-15 * * 1-5"
  ],
  "automerge": true,
  "platformAutomerge": true,
  "npm": {
    "schedule": [
      "* 9-15 * * 1-5"
    ],
    "lockFileMaintenance": {
      "schedule": [
        "* 9-15 * * 1-5"
      ]
    },
    "packageRules": [
      {
        "matchPackageNames": [
          "eslint-config-teppeis"
        ],
        "schedule": [
          "* 9-15 * * 1-5"
        ]
      }
    ]
  }
}
